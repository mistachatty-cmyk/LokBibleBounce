{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LokBibleBounce",
  "version": "0.1.0",
  "identifier": "online.lok.biblebounce",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LokBibleBounce",
        "width": 1120,
        "height": 760,
        "minWidth": 790,
        "minHeight": 540,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 170,
        "height": 170,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["lokbounce"] } } }
}
